# Copy to .env (git-ignored) and fill in privately. Never commit or paste the real token.
# PowerShell, hidden input:
#   $s = Read-Host 'Game Master token' -AsSecureString; "HUNTRESS_GM_TOKEN=$([Net.NetworkCredential]::new('', $s).Password)" | Set-Content -Encoding utf8 .env
HUNTRESS_GM_TOKEN=paste-your-paired-token-here
# Optional; defaults to https://2026.huntress.ctf.games
# HUNTRESS_GM_URL=https://2026.huntress.ctf.games
